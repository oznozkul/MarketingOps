<Project>
  <!-- Test paketi çıktıya testhost.exe koyar ve vstest onu başlatır. Repo klasörü Low bütünlük etiketi taşıdığında
       (bir geliştirme makinesinde yaşandı) bu exe Low seviyede başlar ve ana süreci, %TEMP%'i ve Docker'ı açamaz
       ("Erişim engellendi"). testhost.exe yoksa vstest testhost.dll'i Program Files'taki dotnet ile başlatır; sonuç aynıdır. -->
  <Target Name="ExcludeTestHostAppHost" BeforeTargets="AssignTargetPaths" Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Filename)%(Extension)' == 'testhost.exe' Or '%(Filename)%(Extension)' == 'testhost.x86.exe'" />
    </ItemGroup>
  </Target>
</Project>
