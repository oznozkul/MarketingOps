@model MarketingOps.Web.ViewModels.Notifications.ReportScheduleForm
@{
    var key = Model.Period.ToString();
    var label = DisplayText.Of(Model.Period);
    string? E(string field) => ViewData.ModelState.FirstError(field);
}
<form id="report-@key" class="space-y-4" x-data="{ preview: false }" hx-post="@Url.SiteAction("SaveReport", "NotificationSettings", new { period = Model.Period })" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]" novalidate>
    <div class="flex items-start justify-between gap-3">
        <h3 class="text-sm font-semibold text-fg">@label özet</h3>
        <label class="flex shrink-0 items-center gap-2 text-sm text-fg">
            <input type="checkbox" name="Enabled" value="true" class="checkbox" checked="@Model.Enabled" />Gönder
        </label>
    </div>
    <form-errors />
    <div class="grid gap-3 sm:grid-cols-[10rem_minmax(0,1fr)]">
        <div>
            <label class="label" for="report-@key-time">Gönderim saati</label>
            <input id="report-@key-time" name="SendAt" type="time" value="@Model.SendAt.ToString("HH:mm")" class="input tabular" required
                   aria-invalid="@(E("SendAt") is null ? null : "true")" aria-describedby="@(E("SendAt") is null ? null : "SendAt-error")" />
            <field-error for="SendAt" />
        </div>
        <div>
            <label class="label" for="report-@key-recipients">Alıcılar</label>
            <textarea id="report-@key-recipients" name="Recipients" rows="2" class="textarea font-mono text-xs" spellcheck="false" placeholder="ad@ornek.com (satır başına bir adres)"
                      aria-invalid="@(E("Recipients") is null ? null : "true")" aria-describedby="@(E("Recipients") is null ? null : "Recipients-error")">@Model.Recipients</textarea>
            <field-error for="Recipients" />
        </div>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2">
        <button type="button" class="btn btn-secondary" x-on:click="preview = !preview" :aria-expanded="preview" aria-controls="report-@key-preview">
            <icon name="eye" /><span x-text="preview ? 'Önizlemeyi kapat' : 'Önizle'">Önizle</span>
        </button>
        <partial name="_SubmitButton" model="@("Özeti kaydet")" />
    </div>
    @* E-posta HTML'i sayfanın stillerinden ve betiklerinden yalıtılır. *@
    <div id="report-@key-preview" x-show="preview" x-cloak class="overflow-hidden rounded-sm border border-line bg-white">
        <iframe title="@label özet önizlemesi" sandbox="" class="block h-[42rem] w-full" loading="lazy"
                :src="preview ? '@Url.SiteAction("PreviewReport", "NotificationSettings", new { period = Model.Period })' : 'about:blank'"></iframe>
    </div>
</form>
