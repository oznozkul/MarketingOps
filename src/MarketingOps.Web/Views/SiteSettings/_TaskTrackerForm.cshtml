@model MarketingOps.Web.ViewModels.Sites.TaskTrackerForm
@{
    string? Err(string f) => ViewData.ModelState.FirstError(f);
    string? Invalid(string f) => Err(f) is null ? null : "true";
    string? Described(string f) => Err(f) is null ? null : f + "-error";
}
<form id="task-tracker-form" class="space-y-4" hx-post="@Url.SiteAction("SaveTaskTracker", "SiteSettings")" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]" novalidate>
    <p class="text-sm text-fg-muted">Görevler bu Jira projesine aktarılır. MarketingOps yalnızca kendi açtığı kayıtları oluşturur ve günceller; Jira'dan durum okumaz.</p>
    <form-errors />
    <div>
        <label class="label" for="jira-url">Jira adresi</label>
        <input id="jira-url" name="BaseUrl" value="@Model.BaseUrl" class="input font-mono text-sm" placeholder="https://sirket.atlassian.net" autocomplete="off" spellcheck="false"
               aria-invalid="@Invalid("BaseUrl")" aria-describedby="@Described("BaseUrl")" />
        <field-error for="BaseUrl" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
        <div>
            <label class="label" for="jira-project">Proje anahtarı</label>
            <input id="jira-project" name="ProjectKey" value="@Model.ProjectKey" class="input font-mono uppercase" placeholder="SEO" autocomplete="off"
                   aria-invalid="@Invalid("ProjectKey")" aria-describedby="@Described("ProjectKey")" />
            <field-error for="ProjectKey" />
        </div>
        <div>
            <label class="label" for="jira-type">Kayıt türü</label>
            <input id="jira-type" name="IssueType" value="@Model.IssueType" class="input" placeholder="Task" autocomplete="off"
                   aria-invalid="@Invalid("IssueType")" aria-describedby="@Described("IssueType")" />
            <field-error for="IssueType" />
        </div>
    </div>
    <div>
        <label class="label" for="jira-email">Atlassian hesabı e-postası</label>
        <input id="jira-email" name="Email" type="email" value="@Model.Email" class="input" autocomplete="off"
               aria-invalid="@Invalid("Email")" aria-describedby="@Described("Email")" />
        <field-error for="Email" />
    </div>
    <div>
        <label class="label" for="jira-token">API anahtarı</label>
        <input id="jira-token" name="ApiToken" type="password" class="input font-mono" autocomplete="new-password"
               placeholder="@(Model.HasToken ? "Kayıtlı · değiştirmek için yenisini girin" : "")"
               aria-invalid="@Invalid("ApiToken")" aria-describedby="jira-token-hint@(Err("ApiToken") is null ? "" : " ApiToken-error")" />
        <input type="hidden" name="HasToken" value="@(Model.HasToken ? "true" : "false")" />
        <p id="jira-token-hint" class="hint">id.atlassian.com &gt; Güvenlik &gt; API anahtarları. Şifrelenerek saklanır ve bir daha gösterilmez.</p>
        <field-error for="ApiToken" />
    </div>
    <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost" x-on:click="$dispatch('close-modal')">Vazgeç</button>
        <partial name="_SubmitButton" model="@("Kaydet")" />
    </div>
</form>
