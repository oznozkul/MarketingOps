@model MarketingOps.Application.Crawls.Queries.CrawlListItemResponse
@* Aktif taramanın canlı ilerlemesi. Değerler SignalR ile 2 sn'de bir güncellenir (bkz. app.js "crawlLive"). *@
<section class="card" aria-labelledby="live-crawl-title"
         x-data="crawlLive(@CrawlLiveJson.For(Model))"
         x-on:mo:crawl-progress.window="onProgress($event)" x-on:mo:crawl-finished.window="onFinished($event)">
    <div class="card-header">
        <h2 id="live-crawl-title" class="card-title flex items-center gap-2">
            <icon name="loader-circle" class="h-4 w-4 animate-spin motion-reduce:animate-none" />
            Tarama <span class="tabular">#@Model.Number</span>
            <span class="text-sm font-normal text-fg-muted" x-text="'· ' + stageName"></span>
        </h2>
        <button type="button" class="btn btn-secondary btn-sm" x-on:click="$dispatch('open-modal', 'cancel-crawl')">İptal et</button>
    </div>
    <div class="card-body space-y-4">
        <div class="h-1 w-full bg-surface-3" role="progressbar" aria-label="Tarama ilerlemesi" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="percent">
            <div class="h-full bg-primary transition-[width] duration-500 motion-reduce:transition-none" :style="'width:' + percent + '%'"></div>
        </div>
        <dl class="grid grid-cols-2 gap-4 sm:grid-cols-5" aria-live="polite">
            <div><dt class="eyebrow">İlerleme</dt><dd class="tabular font-mono text-lg text-fg" x-text="'%' + percent">%0</dd></div>
            <div><dt class="eyebrow">Taranan</dt><dd class="tabular font-mono text-lg text-fg"><span x-text="n(pagesCrawled)"></span> <span class="text-sm text-fg-muted">/ <span x-text="n(pagesDiscovered)"></span></span></dd></div>
            <div><dt class="eyebrow">Hata</dt><dd class="tabular font-mono text-lg text-fg" x-text="n(pagesFailed)"></dd></div>
            <div><dt class="eyebrow">Hız</dt><dd class="tabular font-mono text-lg text-fg" x-text="speedText">—</dd></div>
            <div><dt class="eyebrow">Kalan süre</dt><dd class="tabular font-mono text-lg text-fg" x-text="etaText">—</dd></div>
        </dl>
    </div>
</section>
<div x-data="{ open: false }" x-cloak x-on:open-modal.window="if ($event.detail === 'cancel-crawl') open = true" x-on:keydown.escape.window="open = false">
    <div x-show="open" class="fixed inset-0 z-modal flex items-end justify-center p-4 sm:items-center" role="alertdialog" aria-modal="true" aria-labelledby="cancel-crawl-title">
        <div x-show="open" x-transition.opacity class="absolute inset-0 bg-fg/40" x-on:click="open = false"></div>
        <form x-show="open" x-trap.noscroll="open" x-transition class="relative w-full max-w-md rounded border border-line-strong bg-surface p-5 shadow-overlay"
              hx-post="@Url.SiteAction("Cancel", "Crawls", new { crawlId = Model.Id })" hx-disabled-elt="find button[type=submit]">
            <h2 id="cancel-crawl-title" class="text-base font-semibold text-fg">Tarama #@Model.Number iptal edilsin mi?</h2>
            <p class="mt-1 text-sm text-fg-muted">O ana kadar taranan sayfalar saklanır. Tarama "İptal edildi" olarak kapanır.</p>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" class="btn btn-ghost" x-on:click="open = false">Vazgeç</button>
                <button type="submit" class="btn btn-danger"><icon name="loader-circle" class="htmx-indicator h-4 w-4 animate-spin motion-reduce:animate-none" />İptal et</button>
            </div>
        </form>
    </div>
</div>
