@model MarketingOps.Web.ViewModels.Crawls.CrawlsIndexViewModel
@{
    var active = Model.Status.Active;
}
<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="eyebrow">@ViewData.Shell()?.Site.Domain</p>
            <h1 class="page-title mt-1">Taramalar</h1>
            <p class="mt-1 max-w-prose text-sm text-fg-muted">Tarama siteye yalnızca okuma isteği gönderir; robots.txt kurallarına ve sitenin hız limitine uyar.</p>
        </div>
        @if (active is null)
        {
            <form hx-post="@Url.SiteAction("Start", "Crawls")" hx-disabled-elt="find button[type=submit]">
                <button type="submit" class="btn btn-primary">
                    <icon name="loader-circle" class="htmx-indicator h-4 w-4 animate-spin motion-reduce:animate-none" />
                    <icon name="refresh-cw" />Şimdi tara
                </button>
            </form>
        }
    </div>

    @if (active is not null)
    {
        <partial name="_CrawlLiveCard" model="active" />
    }

    @if (Model.Crawls.TotalCount == 0)
    {
        <div class="card">
            <empty-state icon="history" title="Henüz tarama yok" description="İlk tarama ile sayfalar keşfedilir ve sayfa tiplerine ayrılır. Sahipliği doğrulanan sitelerde taramalar ayrıca zamanlanmış olarak çalışır." />
        </div>
    }
    else
    {
        <partial name="_CrawlsTable" model="Model.Crawls" />
    }
</div>
