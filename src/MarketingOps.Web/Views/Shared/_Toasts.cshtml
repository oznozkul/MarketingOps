<div x-data class="pointer-events-none fixed bottom-4 right-4 z-toast flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-2" aria-live="polite" aria-atomic="false">
    <template x-for="t in $store.toasts.items" :key="t.id">
        <div x-transition.opacity class="pointer-events-auto flex items-start gap-3 rounded-sm border bg-surface p-3 text-sm shadow-overlay"
             :class="t.kind === 'error' ? 'border-critical-solid' : 'border-line-strong'" :role="t.kind === 'error' ? 'alert' : 'status'">
            <span :class="t.kind === 'error' ? 'text-critical' : 'text-ok'">
                <template x-if="t.kind === 'error'"><icon name="circle-x" class="mt-0.5 h-4 w-4" /></template>
                <template x-if="t.kind !== 'error'"><icon name="circle-check" class="mt-0.5 h-4 w-4" /></template>
            </span>
            <p class="flex-1 text-fg" x-text="t.message"></p>
            <button type="button" class="-m-1 rounded p-1 text-fg-muted hover:text-fg" @@click="$store.toasts.dismiss(t.id)" aria-label="Bildirimi kapat"><icon name="x" class="h-4 w-4" /></button>
        </div>
    </template>
</div>
