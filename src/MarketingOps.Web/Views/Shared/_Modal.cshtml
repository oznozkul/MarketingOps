@model MarketingOps.Web.ViewModels.ModalViewModel
@* Alpine modalı. Açmak için: $dispatch('open-modal', '@Model.Id'). İçerik bir partial'dır; kapatma: $dispatch('close-modal'). *@
<div x-data="{ open: false }" x-cloak
     x-on:open-modal.window="if ($event.detail === '@Model.Id') open = true"
     x-on:close-modal.window="open = false"
     x-on:keydown.escape.window="open = false">
    <div x-show="open" class="fixed inset-0 z-modal flex items-end justify-center p-4 sm:items-center" role="dialog" aria-modal="true" aria-labelledby="@Model.Id-title">
        <div x-show="open" x-transition.opacity class="absolute inset-0 bg-fg/40" x-on:click="open = false"></div>
        <div x-show="open" x-trap.noscroll="open" x-transition class="relative w-full max-w-md rounded border border-line-strong bg-surface p-5 shadow-overlay">
            <div class="mb-4 flex items-start justify-between gap-3">
                <h2 id="@Model.Id-title" class="text-base font-semibold text-fg">@Model.Title</h2>
                <button type="button" class="icon-btn -m-2" x-on:click="open = false"><icon name="x" label="Kapat" /></button>
            </div>
            <partial name="@Model.PartialName" model="Model.PartialModel" view-data="ViewData" />
        </div>
    </div>
</div>
