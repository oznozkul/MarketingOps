@model MarketingOps.Web.ViewModels.FilterMenuViewModel
@* Açılır çoklu seçim. Kutular filtre formuna aittir; her değişiklik formu gönderir. *@
<div class="relative" x-data="{ open: false }" x-on:click.outside="open = false" x-on:keydown.escape="open = false; $refs.button.focus()">
    <button type="button" x-ref="button" x-on:click="open = !open" :aria-expanded="open" aria-controls="@Model.Id"
            class="inline-flex min-h-[36px] items-center gap-1.5 rounded-sm border px-3 text-sm transition-colors duration-150 hover:bg-surface-2 @(Model.SelectedCount > 0 ? "border-fg-subtle bg-surface-2 text-fg" : "border-line-strong bg-surface text-fg")">
        @Model.Label
        @if (Model.SelectedCount > 0)
        {
            <span class="tabular rounded-sm bg-fg px-1 text-2xs font-semibold text-canvas">@Model.SelectedCount<span class="sr-only"> seçili</span></span>
        }
        <icon name="chevron-down" class="h-3.5 w-3.5 text-fg-muted" />
    </button>
    <fieldset id="@Model.Id" x-cloak x-show="open" x-transition.opacity
              class="absolute left-0 z-overlay mt-1 max-h-80 w-64 overflow-y-auto rounded-sm border border-line-strong bg-surface p-2 shadow-overlay">
        <legend class="sr-only">@Model.Label</legend>
        @foreach (var option in Model.Options)
        {
            <label class="flex min-h-[36px] cursor-pointer items-center gap-2 rounded-sm px-2 text-sm hover:bg-surface-2">
                <input type="checkbox" class="checkbox" form="@Model.Form" name="@Model.Name" value="@option.Value" checked="@option.Selected" />
                <span class="truncate">@option.Label</span>
            </label>
        }
    </fieldset>
</div>
