@model MarketingOps.Web.ViewModels.Tasks.TaskCommentForm
@{
    var taskId = (Guid)ViewData["TaskId"]!;
    var error = ViewData.ModelState.FirstError("Text");
}
<form class="space-y-2" hx-post="@Url.SiteAction("Comment", "Tasks", new { id = taskId })" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button[type=submit]" novalidate>
    <label class="sr-only" for="comment-text">Yorum</label>
    <textarea id="comment-text" name="Text" rows="3" class="textarea text-sm" placeholder="Not ya da soru ekleyin"
              aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : "Text-error")">@Model.Text</textarea>
    <field-error for="Text" />
    <form-errors />
    <div class="flex justify-end"><partial name="_SubmitButton" model="@("Yorum ekle")" /></div>
</form>
