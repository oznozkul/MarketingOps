@model (string Name, string UrlGlob)
<div class="flex items-center gap-2 rounded-sm border border-ok-line bg-ok-soft px-4 py-3 text-sm text-fg" role="status">
    <icon name="circle-check" class="h-4 w-4 shrink-0 text-ok" />
    <span><strong class="font-semibold">@Model.Name</strong> eklendi · <span class="font-mono text-xs">@Model.UrlGlob</span></span>
</div>
